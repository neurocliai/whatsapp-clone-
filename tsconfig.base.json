{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@opero/firebase": ["packages/firebase/src"],
      "@opero/types": ["packages/types/src"],
      "@opero/ui": ["packages/ui/src/index.tsx"],
      "@opero/config": ["packages/config/src"]
    }
  }
}
