# Opero Firebase — copy to apps/*/.env.local and fill values from Firebase Console
# Project: opero-enterprise
# Register a Web app in Firebase Console → Project settings → Your apps → Add app → Web

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=opero-enterprise.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=opero-enterprise
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=opero-enterprise.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://opero-enterprise-default-rtdb.firebaseio.com
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Google Sign-in (Web client ID from Google Cloud Console / Firebase Auth)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# App URLs
NEXT_PUBLIC_LANDING_URL=http://localhost:3000
NEXT_PUBLIC_USER_APP_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_APP_URL=http://localhost:3002
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000

# Server-only (never expose to client)
FIREBASE_ADMIN_PROJECT_ID=opero-enterprise
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
GATEWAY_PORT=4000
